---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'UpSpeak — Learn English, Level Up!',
  description = 'Plataforma web educativa interactiva y gamificada para aprender inglés desde A1 hasta C2.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('upspeak_theme');
          if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <slot />
  </body>
</html>
