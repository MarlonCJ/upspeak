Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proteger código fuente y archivos de configuración en el hosting
  RewriteRule ^src/ - [F,L]
  RewriteRule ^(package(-lock)?\.json|tsconfig\.json|astro\.config\.mjs|tailwind\.config\.mjs|vitest\.config\.ts|ARCHITECTURE\.md)$ - [F,L]

  # Si el archivo o carpeta existe en la raíz (como index.html o _astro/), servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback a index.html
  RewriteRule ^ index.html [L]
</IfModule>
